+         .ib_start_alignment = 32,
+         .ib_size_alignment = 32,
+         .available_rings = 0x1,            /* radv-info: IP GFX queues:1 */
+         .ip_discovery_version = 0xb0004,   /* GC 11.0.4 */
+      },
+      .hw_ip_compute = {
