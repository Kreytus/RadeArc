+++ b/src/amd/common/darwin/ac_darwin_drm.h
@@ -84,6 +84,7 @@ struct amdgpu_device;
 const struct amdgpu_device *acd_canned_device(void);
 uint32_t acd_canned_gb_addr_config(const struct amdgpu_device *d);
 uint32_t acd_canned_gc_version(const struct amdgpu_device *d);
+const struct amdgpu_device *acd_canned_for_gc_version(uint32_t gc_version);
 
 #ifdef __cplusplus
 }
diff --git a/src/amd/common/darwin/ac_darwin_mock.c b/src/amd/common/darwin/ac_darwin_mock.c
index 240f202..28738b7 100644
--- a/src/amd/common/darwin/ac_darwin_mock.c
+++ b/src/amd/common/darwin/ac_darwin_mock.c
@@ -32,6 +32,17 @@
 #define MOCK_PT_CAP (32ull << 20)
 #define MOCK_VA_MASK ((1ull << 48) - 1)
 
+/* The GPU the mock pretends to be: RADV_DARWIN_MOCK_GC (a GC IP version, e.g. 0xb0004 for Phoenix 2) picks the canned
+ * table captured from that version, so the handshake's selection by GC version can be tested without hardware;
+ * otherwise the default table (RADV_DARWIN_CANNED, else phoenix). */
+static const struct amdgpu_device *
+mock_canned(void)
+{
+   const char *gc = getenv("RADV_DARWIN_MOCK_GC");
+   const struct amdgpu_device *d = gc && *gc ? acd_canned_for_gc_version((uint32_t)strtoul(gc, NULL, 0)) : NULL;
+   return d ? d : acd_canned_device();
+}
+
 struct mock_bo {
    bool used;
    uint8_t *mem;
@@ -612,8 +623,8 @@ mock_call(void *ctx, uint32_t sel, const uint64_t *sin, uint32_t nsin, const voi
       inf.reserved[2] = N48N_ABI_MINOR;
       inf.flags = N48N_INFO_S1B_POSITIVE | N48N_INFO_NATIVE_BOOT;
       inf.vmid = 8;
-      inf.gb_addr_config = acd_canned_gb_addr_config(acd_canned_device());
-      inf.gc_version = acd_canned_gc_version(acd_canned_device());
+      inf.gb_addr_config = acd_canned_gb_addr_config(mock_canned());
+      inf.gc_version = acd_canned_gc_version(mock_canned());
       inf.ring_size_dw = 4096;
       inf.max_ibs = N48N_MAX_IBS;
       inf.vram_vis_total = MOCK_VIS_TOTAL;
@@ -642,7 +653,7 @@ mock_call(void *ctx, uint32_t sel, const uint64_t *sin, uint32_t nsin, const voi
       uint32_t v[16] = {0};
       for (uint64_t i = 0; i < sin[1]; i++)
          v[i] = (sin[0] + i == ACD_GB_ADDR_CONFIG_REG)
-                    ? acd_canned_gb_addr_config(acd_canned_device()) : 0;
+                    ? acd_canned_gb_addr_config(mock_canned()) : 0;
       memcpy(stout, v, sin[1] * 4);
       *stoutsz = sin[1] * 4;
       break;
