+         .chip_rev = 0x02,
+         .external_rev = 0x82,              /* chip_external_rev 130: AMDGPU_PHOENIX2_RANGE 0x80..0xC0 */
+         .pci_rev = 0xc5,
+         .family = AMDGPU_FAMILY_GC_11_0_1, /* family_id 148 */
+         .num_shader_engines = 1,           /* gc_num_se */
+         .num_shader_arrays_per_engine = 1, /* gc_num_sa_per_se, radv-info max_sa_per_se */
+         .gpu_counter_freq = 100000,        /* clock_crystal_freq = 100000 KHz */
+         .max_engine_clock = UINT64_C(2799000), /* max_gpu_freq = 2799 MHz */
+         .max_memory_clock = UINT64_C(2600000), /* max_memory_clock = 2600 MHz */
+         .cu_active_number = 4,             /* num_cu */
+         .cu_ao_mask = 0x0,
+         .cu_bitmap = {
+            { 0xf, 0x0, 0x0, 0x0, },        /* cu_mask[SE0][SA0] = 0xf */
+            { 0x0, 0x0, 0x0, 0x0, },
+            { 0x0, 0x0, 0x0, 0x0, },
+            { 0x0, 0x0, 0x0, 0x0, },
+         },
+         .enabled_rb_pipes_mask = 0x1,      /* enabled_rb_mask */
+         .num_rb_pipes = 1,                 /* max_render_backends, gc_num_rb_per_se */
+         .num_hw_gfx_contexts = 8,          /* gfx_v11_0_gpu_early_init: max_hw_contexts */
+         .pcie_gen = 4,
+         /* amdgpu_info_ioctl: FUSION (APU; has_dedicated_vram = 0) | CONFORMANT_TRUNC_COORD
+          * (conformant_trunc_coord = 1). No TMZ: has_tmz_support = 0 on this chip. Bit 0x10 as in
+          * the phoenix entry (not read by this Mesa). */
+         .ids_flags = UINT64_C(0x19),
+         .virtual_address_offset = UINT64_C(0x10000),
+         .virtual_address_max = UINT64_C(0x800000000000),
+         .virtual_address_alignment = 4096,
+         .pte_fragment_size = 2097152,      /* pte_fragment_size */
+         .gart_page_size = 4096,            /* gart_page_size */
+         .ce_ram_size = 0,
+         .vram_type = 10,                   /* AMDGPU_VRAM_TYPE_DDR5 */
+         .vram_bit_width = 64,              /* memory_bus_width = 64 bits */
+         .vce_harvest_config = 0,
+         .gc_double_offchip_lds_buf = 0,    /* gc_double_offchip_lds_buffer */
+         .prim_buf_gpu_addr = UINT64_C(0),
+         .pos_buf_gpu_addr = UINT64_C(0),
+         .cntl_sb_buf_gpu_addr = UINT64_C(0),
+         .param_buf_gpu_addr = UINT64_C(0),
+         .prim_buf_size = 0,
+         .pos_buf_size = 0,
+         .cntl_sb_buf_size = 0,
+         .param_buf_size = 0,
+         .wave_front_size = 32,             /* gc_wave_size */
+         .num_shader_visible_vgprs = 1024,  /* gc_num_gprs */
+         .num_cu_per_sh = 4,                /* num_cu_per_sh */
+         .num_tcc_blocks = 4,               /* gc_num_gl2c, max_tcc_blocks */
+         .gs_vgt_table_depth = 32,          /* gc_gs_table_depth */
+         .gs_prim_buffer_depth = 1792,      /* gc_gsprim_buff_depth */
+         .max_gs_waves_per_vgt = 32,        /* gc_num_max_gs_thds */
+         .pcie_num_lanes = 16,
+         .cu_ao_bitmap = {
+            { 0x0, 0x0, 0x0, 0x0, },
+            { 0x0, 0x0, 0x0, 0x0, },
+            { 0x0, 0x0, 0x0, 0x0, },
+            { 0x0, 0x0, 0x0, 0x0, },
+         },
+         .high_va_offset = UINT64_C(0xffff800000000000),
+         .high_va_max = UINT64_C(0xffffffffffbfe000),
+         .pa_sc_tile_steering_override = 0, /* pa_sc_tile_steering_override = 0x0 */
+         .tcc_disabled_mask = UINT64_C(0),
+         .min_engine_clock = UINT64_C(800000),
+         .min_memory_clock = UINT64_C(400000),
+         .tcp_cache_size = 32,              /* gc_tcp_l1_size */
+         .num_sqc_per_wgp = 1,              /* gc_num_sqc_per_wgp */
+         .sqc_data_cache_size = 16,         /* gc_l1_data_cache_size_per_sqc */
+         .sqc_inst_cache_size = 32,         /* gc_l1_instruction_cache_size_per_sqc */
+         .gl1c_cache_size = 256,            /* gc_gl1c_per_sa 4 x gc_gl1c_size_per_instance 64 */
+         .gl2c_cache_size = 1024,           /* gc_gl2c_per_gpu */
+         .mall_size = UINT64_C(0),
+         .enabled_rb_pipes_mask_hi = 0,
+      },
