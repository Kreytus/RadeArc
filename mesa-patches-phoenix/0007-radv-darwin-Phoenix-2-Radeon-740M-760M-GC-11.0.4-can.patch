diff --git a/src/amd/common/darwin/ac_darwin_drm.c b/src/amd/common/darwin/ac_darwin_drm.c
index 317d4e4..9fa56d2 100644
--- a/src/amd/common/darwin/ac_darwin_drm.c
+++ b/src/amd/common/darwin/ac_darwin_drm.c
@@ -13,6 +13,7 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+#include <sys/sysctl.h>
 
 #include "common/amd_family.h"
 #include "common/amdgpu_devices.h"
@@ -59,6 +60,7 @@ struct amdgpu_bo {
  * device to go closes the connection. */
 struct acd_core {
    int refcount;
+   const struct amdgpu_device *canned; /* the table the handshake chose (by the kext's GC version) */
    uint32_t minor; /* ABI minor the kernel reported */
    bool shared; /* the process-wide core (false: the private HOST_BO stand-in core) */
    struct acd_kext *kext; /* NULL in the HOST_BO stand-in */
@@ -89,8 +91,10 @@ static struct acd_core *g_core;
 static const struct amdgpu_device *
 find_canned(const char *name);
 
-/* Canned device selection: RADV_DARWIN_CANNED names an amdgpu_devices[] entry, default "phoenix"
- * (Radeon 780M / gfx1103 / GC 11.0.1). The values that used to be gfx1201 constants come from it. */
+/* Canned device selection without a kext (HOST_BO stand-in, the mock's own answers): RADV_DARWIN_CANNED names an
+ * amdgpu_devices[] entry, default "phoenix" (Radeon 780M / gfx1103 / GC 11.0.1). With a kext the handshake picks the
+ * table from the GC version the kext read from the IP discovery table (acd_canned_for_gc_version); the variable then
+ * only overrides that choice. */
 const struct amdgpu_device *
 acd_canned_device(void)
 {
@@ -111,6 +115,11 @@ acd_canned_gb_addr_config(const struct amdgpu_device *d)
 uint32_t
 acd_canned_gc_version(const struct amdgpu_device *d)
 {
+   /* the GC IP version the table was captured from (AMDGPU_INFO_HW_IP_INFO ip_discovery_version, major << 16 |
+    * minor << 8 | revision, the same encoding as n48n_info.gc_version): tells Phoenix 1 (11.0.1) from Phoenix 2
+    * (11.0.4), which share the family id */
+   if (d->hw_ip_gfx.ip_discovery_version)
+      return d->hw_ip_gfx.ip_discovery_version;
    switch (d->dev.family) {
    case AMDGPU_FAMILY_GC_11_0_1: return (11u << 16) | (0u << 8) | 1u;
    case AMDGPU_FAMILY_GC_12_0_0: return (12u << 16) | (0u << 8) | 1u;
@@ -118,6 +127,20 @@ acd_canned_gc_version(const struct amdgpu_device *d)
    }
 }
 
+/* The table for the GPU the kext found: the one captured from that exact GC IP version (not the PCI id, so one build
+ * serves the Radeon 780M, 760M and 740M). NULL when no table matches: no device then. */
+const struct amdgpu_device *
+acd_canned_for_gc_version(uint32_t gc_version)
+{
+   if (!gc_version)
+      return NULL;
+   for (uint32_t i = 0; i < num_amdgpu_devices; i++) {
+      if (acd_canned_gc_version(&amdgpu_devices[i]) == gc_version)
+         return &amdgpu_devices[i];
+   }
+   return NULL;
+}
+
 static const struct amdgpu_device *
 find_canned(const char *name)
 {
@@ -148,7 +171,7 @@ env_is_1(const char *name)
 
 /* Hello, live checks and the info snapshot; every failure is one clear stderr line. */
 static int
-acd_native_handshake(struct acd_kext *kext, const struct amdgpu_device *canned, uint32_t *minor_out)
+acd_native_handshake(struct acd_kext *kext, const struct amdgpu_device **canned_out, uint32_t *minor_out)
 {
    struct acd_hello h;
    int r = acd_kext_hello(kext, &h);
@@ -174,6 +197,26 @@ acd_native_handshake(struct acd_kext *kext, const struct amdgpu_device *canned,
       return r;
    }
 
+   /* The canned table: RADV_DARWIN_CANNED if set, else the one for the kext's GC version. */
+   const struct amdgpu_device *canned = NULL;
+   const char *forced = getenv("RADV_DARWIN_CANNED");
+   if (forced && *forced) {
+      canned = find_canned(forced);
+      if (!canned) {
+         fprintf(stderr, "radv-darwin: RADV_DARWIN_CANNED=%s is not a known table\n", forced);
+         return -ENODEV;
+      }
+   } else {
+      canned = acd_canned_for_gc_version(info.gc_version);
+      if (!canned) {
+         fprintf(stderr, "radv-darwin: no canned device info for GC %u.%u.%u (kext gc_version 0x%x)\n",
+                 (info.gc_version >> 16) & 0xff, (info.gc_version >> 8) & 0xff, info.gc_version & 0xff,
+                 info.gc_version);
+         return -ENODEV;
+      }
+   }
+   *canned_out = canned;
+
    /* GB_ADDR_CONFIG: the tiling layout the canned info and S1d's image assume. QueryInfo carries the live value
     * (n48n_info.gb_addr_config); ReadRegs is root-only and refused for a user-application (G4 APP) session, so it is
     * only the fallback for a kernel that left the field 0. */
@@ -209,9 +252,9 @@ acd_native_handshake(struct acd_kext *kext, const struct amdgpu_device *canned,
    static bool logged;
    if (!logged) {
       logged = true;
-      fprintf(stderr, "radv-darwin: native kext: ABI %u.%u, build %u, VMID %u, max %u IBs/submit, GB_ADDR_CONFIG "
-                      "0x%08x, VRAM %llu MiB visible + %llu MiB hi, GTT cap %llu MiB\n",
-              h.abi, h.minor, h.build, h.vmid, h.max_ibs, gb, (unsigned long long)(info.vram_vis_total >> 20),
+      fprintf(stderr, "radv-darwin: native kext: ABI %u.%u, build %u, VMID %u, max %u IBs/submit, canned %s, "
+                      "GB_ADDR_CONFIG 0x%08x, VRAM %llu MiB visible + %llu MiB hi, GTT cap %llu MiB\n",
+              h.abi, h.minor, h.build, h.vmid, h.max_ibs, canned->name, gb, (unsigned long long)(info.vram_vis_total >> 20),
               (unsigned long long)(info.vram_hi_total >> 20), (unsigned long long)(info.gtt_cap >> 20));
    }
    return 0;
@@ -234,11 +277,12 @@ acd_core_create(const struct amdgpu_device *canned, bool host_bo, struct acd_cor
       return -ENOMEM;
    pthread_mutex_init(&c->bo_lock, NULL);
    c->refcount = 1;
+   c->canned = canned;
 
    if (!host_bo) {
       int r = acd_kext_open(&c->kext);
       if (r == 0)
-         r = acd_native_handshake(c->kext, canned, &c->minor);
+         r = acd_native_handshake(c->kext, &c->canned, &c->minor);
       if (r) {
          acd_kext_destroy(c->kext);
          pthread_mutex_destroy(&c->bo_lock);
@@ -260,7 +304,7 @@ acd_core_create(const struct amdgpu_device *canned, bool host_bo, struct acd_cor
       return -ENOMEM;
    }
 
-   const struct drm_amdgpu_info_device *di = &canned->dev;
+   const struct drm_amdgpu_info_device *di = &c->canned->dev;
    /* gfx12: RADV needs half of the VA range reserved for PRT, as on Linux. */
    amdgpu_va_manager_init2(c->va_mgr, di->virtual_address_offset, di->virtual_address_max, di->high_va_offset,
                            di->high_va_max, di->virtual_address_alignment, AMDGPU_VA_MGR_RESERVE_HALF_VA_FOR_PRT);
@@ -319,6 +363,7 @@ acd_device_initialize(uint32_t *drm_major, uint32_t *drm_minor, acd_device_handl
       free(dev);
       return r;
    }
+   dev->canned = dev->core->canned; /* with a kext: the table for its GC version */
 
    dev->sync = dev->core->sync->clone(dev->core->sync);
    if (!dev->sync) {
@@ -360,11 +405,38 @@ acd_device_get_sync_provider(acd_device_handle dev)
    return dev->sync;
 }
 
+static char acd_phoenix2_name[48] = "AMD Radeon Graphics";
+
+/* "AMD Radeon <model> Graphics" from the brand string's "Radeon <model>" when the model ends in M (740M, 760M). */
+static void
+acd_phoenix2_name_init(void)
+{
+   char brand[128] = {0};
+   size_t n = sizeof(brand) - 1;
+   if (sysctlbyname("machdep.cpu.brand_string", brand, &n, NULL, 0))
+      return;
+   const char *p = strstr(brand, "Radeon ");
+   if (!p)
+      return;
+   p += 7;
+   size_t len = strcspn(p, " ");
+   if (len && len <= 8 && p[len - 1] == 'M')
+      snprintf(acd_phoenix2_name, sizeof(acd_phoenix2_name), "AMD Radeon %.*s Graphics", (int)len, p);
+}
+
 const char *
 acd_get_marketing_name(acd_device_handle dev)
 {
    if (!strcmp(dev->canned->name, "phoenix"))
       return "AMD Radeon 780M Graphics";
+   if (!strcmp(dev->canned->name, "phoenix2")) {
+      /* Phoenix 2 is sold as the 740M or the 760M; the CPU brand string names it ("AMD Ryzen 5 8500G w/ Radeon 740M
+       * Graphics"), as PhxBringup names the PCI device. Otherwise what Linux reports for 1002:15C8: "AMD Radeon
+       * Graphics" (radv-info marketing_name on the 8500G). */
+      static pthread_once_t once = PTHREAD_ONCE_INIT;
+      pthread_once(&once, acd_phoenix2_name_init);
+      return acd_phoenix2_name;
+   }
    return ACD_MARKETING_NAME;
 }
 
diff --git a/src/amd/common/darwin/ac_darwin_drm.h b/src/amd/common/darwin/ac_darwin_drm.h
index 1db9014..1f13454 100644
