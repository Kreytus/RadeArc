+            .usable_heap_size = UINT64_C(2147483648),
+            .heap_usage = UINT64_C(0),
+            .max_allocation = UINT64_C(1610612736),
+         },
+         .cpu_accessible_vram = {
+            .total_heap_size = UINT64_C(2147483648),
+            .usable_heap_size = UINT64_C(2147483648),
+            .heap_usage = UINT64_C(0),
+            .max_allocation = UINT64_C(1610612736),
+         },
+         .gtt = {
+            .total_heap_size = UINT64_C(7121420288),
+            .usable_heap_size = UINT64_C(7121420288),
+            .heap_usage = UINT64_C(0),
+            .max_allocation = UINT64_C(5341065216),
